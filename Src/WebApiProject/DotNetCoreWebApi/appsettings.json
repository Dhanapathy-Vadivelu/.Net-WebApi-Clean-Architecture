{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Dev-PC\\SQLEXPRESS;Database=WebApiDataBase;User ID=sa;Password=123;TrustServerCertificate=True;"
  },
  "OAuth": {
    "Issuer": "DotNetCoreWebApi",
    "Audience": "DotNetCoreWebApi.Client",
    "SigningKey": "REPLACE_WITH_A_STRONG_32_PLUS_CHAR_SECRET_KEY",
    "AccessTokenExpirationMinutes": 60,
    "DefaultScope": "api",
    "ExternalIdp": {
      "Enabled": false,
      "Authority": "https://your-idp-authority",
      "Audience": "your-idp-api-audience",
      "ValidIssuer": "https://your-idp-authority",
      "RequireHttpsMetadata": true
    }
  },
  "Notification": {
    "Email": {
      "Provider": "GmailSmtp",
      "SenderEmail": "your-email@gmail.com",
      "SenderDisplayName": "DotNetLibrary",
      "GmailSmtp": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "Username": "your-email@gmail.com",
        "Password": "your-app-password",
        "EnableSsl": true
      },
      "AzureEmailService": {
        "Endpoint": "https://<resource-name>.<region>.communication.azure.com",
        "AccessKey": "<azure-email-service-access-key>"
      }
    },
    "Sms": {
      "Enabled": false
    }
  }
}
